# Atheris fuzz job (.github/workflows/fuzz.yml): the runtime set plus
# atheris and the pinned build backend. Atheris ships Linux x86_64 wheels
# only, so this is compiled for that platform:
#   uv pip compile --generate-hashes --python-platform x86_64-manylinux_2_17 \
#     --python-version 3.12 requirements/fuzz.in -o requirements/fuzz.txt
-r runtime.in
